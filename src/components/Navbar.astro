---
---
<nav class="sticky top-0 z-40 w-full bg-white/70 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex-shrink-0">
        <a href="https://ana-catalina.com/" class="flex items-center">
          <img src="/favicon.svg" alt="ACVC Logo" width="32" height="32" class="w-8 h-8 rounded-lg object-contain">
        </a>
      </div>
      
      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-6">
        <div class="ml-10 flex items-baseline space-x-6">
          <a href="#experience" data-i18n="nav.experiencia" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
            Experiencia
          </a>
          <a href="#skills" data-i18n="nav.habilidades" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Habilidades</a>
          <a href="#education" data-i18n="nav.publicaciones" class="text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">Formación y Publicaciones</a>
        </div>
        
        <!-- Desktop Language Toggle Button -->
        <button id="lang-toggle-desktop" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none transition-all duration-200 hover:scale-105 font-bold text-sm" aria-label="Cambiar idioma">
          <span id="current-lang-desktop">ES</span>
        </button>
        
        <!-- Desktop Theme Toggle Button -->
        <button id="theme-toggle-desktop" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none transition-all duration-200 hover:scale-105" aria-label="Cambiar tema">
          <!-- Sun Icon (visible in dark mode) -->
          <svg id="theme-toggle-light-icon-desktop" class="hidden w-5 h-5 transition-transform duration-300 rotate-0 dark:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <!-- Moon Icon (visible in light mode) -->
          <svg id="theme-toggle-dark-icon-desktop" class="hidden w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="flex items-center space-x-2 md:hidden">
        <!-- Mobile Language Toggle Button -->
        <button id="lang-toggle-mobile" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none transition-all duration-200 font-bold text-sm" aria-label="Cambiar idioma">
          <span id="current-lang-mobile">ES</span>
        </button>

        <!-- Mobile Theme Toggle Button -->
        <button id="theme-toggle-mobile" class="p-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 focus:outline-none transition-all duration-200" aria-label="Cambiar tema">
          <!-- Sun Icon (visible in dark mode) -->
          <svg id="theme-toggle-light-icon-mobile" class="hidden w-5 h-5 transition-transform duration-300 rotate-0 dark:rotate-90" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
          </svg>
          <!-- Moon Icon (visible in light mode) -->
          <svg id="theme-toggle-dark-icon-mobile" class="hidden w-5 h-5 transition-transform duration-300" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>
        
        <button id="mobile-menu-btn" class="inline-flex items-center justify-center p-2 rounded-xl text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 focus:outline-none transition-colors" aria-expanded="false" aria-label="Abrir menú de navegación">
          <svg class="h-6 w-6" id="menu-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
          </svg>
          <svg class="h-6 w-6 hidden" id="close-icon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200/50 dark:border-slate-800/50 bg-white/95 dark:bg-slate-900/95 backdrop-blur-md transition-all duration-300 ease-in-out">
    <div class="px-2 pt-2 pb-4 space-y-1 sm:px-3">
      <a href="#experience" data-i18n="nav.experiencia" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all">
            Experiencia
          </a>
      <a href="#skills" data-i18n="nav.habilidades" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all">Habilidades</a>
      <a href="#education" data-i18n="nav.publicaciones" class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-slate-600 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-all">Formación y Publicaciones</a>
    </div>
  </div>
</nav>
