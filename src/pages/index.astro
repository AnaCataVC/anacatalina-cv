---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PoppyBackground from '../components/PoppyBackground.astro';
import fotoPerfil from '../assets/foto-perfil.jpg';
import { cvData } from '../data/cv';

// Single source of truth: the badge markup below is omitted from the HTML
// entirely when false, instead of being hidden client-side after JS runs.
const isAvailableForWork = false;

const badgeClasses: Record<string, string> = {
  violet: 'bg-brand-violet/10 dark:bg-brand-violet/15 text-brand-violet dark:text-brand-violet-light border border-brand-violet/20 dark:border-brand-violet/30',
  aqua: 'bg-brand-aqua/10 dark:bg-brand-aqua/15 text-teal-800 dark:text-brand-aqua border border-brand-aqua/25 dark:border-brand-aqua/30',
  slate: 'bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-600/50',
  mint: 'bg-brand-aqua/10 dark:bg-brand-aqua/15 text-teal-800 dark:text-brand-aqua border border-brand-aqua/25 dark:border-brand-aqua/30',
  pink: 'bg-brand-violet/10 dark:bg-brand-violet/15 text-brand-violet dark:text-brand-violet-light border border-brand-violet/20 dark:border-brand-violet/30',
  blue: 'bg-brand-aqua/10 dark:bg-brand-aqua/15 text-teal-800 dark:text-brand-aqua border border-brand-aqua/25 dark:border-brand-aqua/30',
  lilac: 'bg-brand-violet/10 dark:bg-brand-violet/15 text-brand-violet dark:text-brand-violet-light border border-brand-violet/20 dark:border-brand-violet/30',
};
---
<Layout title="Ana-Catalina Villalobos | Data Scientist, ML & AI Engineer" description="CV y Portafolio Profesional de Ana-Catalina Villalobos Contardo, Ingeniera Civil, Data Scientist, Machine Learning & AI Engineer especialista en infraestructura agéntica (MCP), sistemas distribuidos, pipelines de datos en GCP y liderazgo técnico.">
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ana-Catalina Villalobos Contardo",
      "jobTitle": [
        "Data Scientist & Machine Learning Engineer",
        "AI Systems Engineer",
        "Technical Lead"
      ],
      "url": "https://cv.ana-catalina.com/",
      "sameAs": [
        "https://ana-catalina.com/",
        "https://projects.ana-catalina.com/",
        "https://mcp.ana-catalina.com/",
        "https://linkedin.com/in/ana-catalina/",
        "https://github.com/AnaCataVC/"
      ],
      "worksFor": {
        "@type": "Organization",
        "name": "SimpliRoute",
        "url": "https://simpliroute.com/"
      },
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universidad de Chile",
        "url": "https://uchile.cl/"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Región Metropolitana",
        "addressCountry": "CL"
      },
      "knowsAbout": [
        "Data Science",
        "Machine Learning Engineering",
        "Agentic AI",
        "Model Context Protocol (MCP)",
        "Multi-Agent Systems",
        "Distributed Systems",
        "Data Engineering",
        "Python",
        "FastAPI",
        "LangChain",
        "Google Cloud Platform",
        "BigQuery",
        "Google Cloud Dataflow",
        "Apache Airflow",
        "Kubernetes",
        "Redis",
        "Predictive Maintenance",
        "Technical Leadership"
      ]
    }
  </script>

  <!-- Hero and Experience Wrapper for Background Glow -->
  <div class="relative overflow-hidden">
  <!-- Hero Section -->
  <header id="home" class="relative w-full pt-12 pb-16 md:pt-0 md:pb-0 md:min-h-screen md:flex md:items-center">
    <!-- Background Blur Blobs for Premium Aesthetic -->
    

    

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
        <!-- Profile details & Photo (Left Column on Desktop, Top on Mobile) -->
        <div class="md:col-span-6 flex flex-col items-center md:items-start text-center md:text-left space-y-6 animate-fade-in-up">
          {isAvailableForWork && (
            <div id="availability-badge" class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-brand-aqua/15 dark:bg-brand-aqua/10 border border-brand-aqua/30 text-teal-900 dark:text-brand-aqua font-medium text-xs tracking-wide">
              <span class="w-2 h-2 rounded-full bg-brand-aqua animate-ping"></span>
              <span data-i18n="hero.badge">Disponible para Proyectos & Liderazgo de Datos</span>
            </div>
          )}

          <h1 class="text-3xl sm:text-4xl md:text-[2.75rem] lg:text-[3.25rem] xl:text-[3.75rem] font-bold tracking-tight text-slate-900 dark:text-white leading-[1.12] m-0">
            <span class="text-brand-violet dark:text-brand-violet-light">Ana-Catalina</span> <br> Villalobos Contardo<span class="text-brand-aqua hover:drop-shadow-[0_0_8px_rgba(46,230,229,0.8)] cursor-default transition-all duration-500 ease-out">.</span>
          </h1>
          
          <div class="space-y-1.5">
            <p data-i18n="hero.subtitle" class="text-lg sm:text-xl font-medium text-slate-600 dark:text-slate-300">
              Data Scientist & Machine Learning Engineer
            </p>
            <p data-i18n="hero.pillars" class="text-xs sm:text-sm font-medium text-brand-violet dark:text-brand-violet-light tracking-wide">
              IA Agéntica & MCP · Pipelines de Datos · Liderazgo Técnico
            </p>
          </div>

          <!-- Interactive Profile Card / Medallion -->
          <div class="relative pt-2 group/avatar">
            <!-- Decorative outline glow / Ambient medallion glow -->
            <div class="absolute -inset-1 rounded-[26.5px] blur-sm opacity-10 dark:opacity-15 bg-brand-purple pointer-events-none transition-opacity duration-500 group-hover/avatar:opacity-20"></div>

            <!-- Avatar medallion frame with solid primary color border -->
            <div class="relative p-[2.5px] rounded-[22.5px] bg-brand-purple shadow-sm transition-all duration-300 group-hover/avatar:scale-[1.01]">
              <div class="relative w-56 h-56 sm:w-64 sm:h-64 bg-white dark:bg-slate-800 p-2 rounded-[20px] flex items-center justify-center overflow-hidden">
                <Image src={fotoPerfil} alt="Ana-Catalina Villalobos" width={320} height={320} loading="eager" fetchpriority="high" format="webp" quality={80} class="w-full h-full object-cover rounded-xl" />
              </div>
            </div>
            
            <!-- Minimal tag overlay linked to SimpliRoute experience -->
            <a href="#simpliroute" class="absolute -bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap bg-white dark:bg-slate-800 px-4 py-2 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 flex items-center space-x-2 hover:border-brand-purple dark:hover:border-brand-purple focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900 transition-all group/tag">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-cyan opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-cyan"></span>
              </span>
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 group-hover/tag:text-brand-purple dark:group-hover/tag:text-brand-purple transition-colors">Learning Engineer (ML & AI) @ SimpliRoute</span>
            </a>
          </div>

          <!-- Action Buttons (Mobile) -->
          <div class="flex md:hidden flex-wrap items-center justify-center gap-3 w-56 sm:w-64 pt-4">
            <a href={`ACVC_es.pdf?v=${cvData.meta.lastUpdated}`} target="_blank" rel="noopener noreferrer" data-i18n="hero.downloadBtn" data-i18n-href="hero.cvUrl" class="touch-manipulation flex-1 min-w-[140px] inline-flex items-center justify-center px-6 py-3 rounded-2xl bg-gradient-to-r from-violet-600 to-brand-violet hover:from-violet-500 hover:to-brand-violet-light shadow-sm hover:shadow-[0_0_22px_rgba(139,92,246,0.45)] transition-all transform hover:-translate-y-0.5 text-white tracking-wide font-semibold text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
              Descargar CV
            </a>
          </div>

          <!-- Social Details Quick Links & Location -->
          <div class="flex flex-wrap justify-center items-center gap-3 pt-2 text-slate-600 dark:text-slate-400 w-56 sm:w-64">
            <a href="mailto:anacatalina@outlook.cl" class="touch-manipulation flex items-center justify-center w-10 h-10 rounded-full bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-cyan-500/10 dark:hover:bg-slate-700 hover:text-brand-aqua dark:hover:text-brand-aqua hover:border-brand-aqua/50 dark:hover:border-brand-aqua/50 transition-all duration-300 transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_15px_rgba(46,230,229,0.2)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" title="Enviar correo a Ana-Catalina" aria-label="Enviar correo a Ana-Catalina" data-i18n-aria="aria.email">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <a href="https://linkedin.com/in/ana-catalina/" target="_blank" rel="noopener noreferrer" class="touch-manipulation flex items-center justify-center w-10 h-10 rounded-full bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-cyan-500/10 dark:hover:bg-slate-700 hover:text-brand-aqua dark:hover:text-brand-aqua hover:border-brand-aqua/50 dark:hover:border-brand-aqua/50 transition-all duration-300 transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_15px_rgba(46,230,229,0.2)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" title="Perfil de LinkedIn de Ana-Catalina" aria-label="Perfil de LinkedIn de Ana-Catalina" data-i18n-aria="aria.linkedin">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://github.com/AnaCataVC/" target="_blank" rel="noopener noreferrer" class="touch-manipulation flex items-center justify-center w-10 h-10 rounded-full bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-cyan-500/10 dark:hover:bg-slate-700 hover:text-brand-aqua dark:hover:text-brand-aqua hover:border-brand-aqua/50 dark:hover:border-brand-aqua/50 transition-all duration-300 transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_15px_rgba(46,230,229,0.2)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" title="Perfil de GitHub de Ana-Catalina" aria-label="Perfil de GitHub de Ana-Catalina" data-i18n-aria="aria.github">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
            <a href="https://projects.ana-catalina.com/" target="_blank" rel="noopener noreferrer" class="touch-manipulation flex items-center justify-center w-10 h-10 rounded-full bg-slate-50/80 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:bg-cyan-500/10 dark:hover:bg-slate-700 hover:text-brand-aqua dark:hover:text-brand-aqua hover:border-brand-aqua/50 dark:hover:border-brand-aqua/50 transition-all duration-300 transform hover:-translate-y-0.5 shadow-sm hover:shadow-[0_0_15px_rgba(46,230,229,0.2)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900" title="Portafolio de Proyectos de Ana-Catalina" aria-label="Portafolio de Proyectos de Ana-Catalina" data-i18n-aria="aria.projects">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M10 10.5 8 13l2 2.5"/><path d="m14 10.5 2 2.5-2 2.5"/><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2z"/></svg>
            </a>
            <span class="text-sm inline-flex md:hidden items-center space-x-1.5 font-medium whitespace-nowrap mt-2">
              <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span data-i18n="hero.location">Región Metropolitana, Chile</span>
            </span>
          </div>
        </div>

        <!-- About Me Section (Right Column on Desktop, Bottom on Mobile) -->
        <div class="md:col-span-6 flex flex-col justify-center space-y-6 animate-fade-in md:pl-6 relative">
          <PoppyBackground class="absolute top-1/2 -translate-y-1/2 -right-20 w-[600px] h-[600px] lg:w-[800px] lg:h-[800px] opacity-[0.04] dark:opacity-[0.06] pointer-events-none text-brand-purple dark:text-brand-violet-light -z-10" />
          <!-- "Sobre Mí" Title -->
          <h2 class="text-xl font-bold tracking-wider text-brand-violet dark:text-brand-violet-light uppercase text-center md:text-left mb-4" data-i18n="about.title">Sobre Mí</h2>

          <!-- Desktop Top Meta & Actions -->
          <div class="hidden md:flex flex-col space-y-5 mb-4">
            <span class="text-sm inline-flex items-center space-x-1.5 font-medium whitespace-nowrap text-slate-600 dark:text-slate-400">
              <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span data-i18n="hero.location">Región Metropolitana, Chile</span>
            </span>

            <div class="flex flex-wrap items-center justify-start gap-3 lg:gap-4">
              <a href={`ACVC_es.pdf?v=${cvData.meta.lastUpdated}`} target="_blank" rel="noopener noreferrer" data-i18n="hero.downloadBtn" data-i18n-href="hero.cvUrl" class="touch-manipulation flex-1 lg:flex-none lg:min-w-[150px] inline-flex items-center justify-center px-6 lg:px-8 py-3 lg:py-3.5 rounded-2xl bg-gradient-to-r from-violet-600 to-brand-violet hover:from-violet-500 hover:to-brand-violet-light shadow-sm hover:shadow-[0_0_22px_rgba(139,92,246,0.45)] transition-all transform hover:-translate-y-0.5 text-white tracking-wide font-semibold text-xs lg:text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                Descargar CV
              </a>
              <a href="#experience" data-i18n="hero.expBtn" class="touch-manipulation flex-1 lg:flex-none lg:min-w-[140px] inline-flex items-center justify-center px-5 lg:px-6 py-3 lg:py-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-brand-purple dark:hover:border-brand-cyan hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-all duration-300 transform hover:-translate-y-0.5 text-slate-700 dark:text-slate-200 hover:text-brand-purple dark:hover:text-brand-cyan tracking-wide font-medium text-xs lg:text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                Experiencia
              </a>
              <a href="#skills" data-i18n="hero.skillsBtn" class="touch-manipulation flex-1 lg:flex-none lg:min-w-[140px] inline-flex items-center justify-center px-5 lg:px-6 py-3 lg:py-3.5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm hover:shadow-md hover:border-brand-purple dark:hover:border-brand-cyan hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-all duration-300 transform hover:-translate-y-0.5 text-slate-700 dark:text-slate-200 hover:text-brand-purple dark:hover:text-brand-cyan tracking-wide font-medium text-xs lg:text-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-purple focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                Habilidades
              </a>
            </div>
          </div>
          
          <div class="space-y-4 text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed text-sm sm:text-base text-left">
            <p data-i18n="about.p1" class="text-lg font-semibold text-slate-800 dark:text-slate-100 leading-relaxed text-left" set:html={cvData.basics.summary.web[0].es} />
            <p data-i18n="about.p2" set:html={cvData.basics.summary.web[1].es} />
            <p data-i18n="about.p3" set:html={cvData.basics.summary.web[2].es} />
          </div>
        </div>
      </div>
    </div>
  </header>



  <!-- Experience Section -->
  <section id="experience" class="py-20 relative scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-3 mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n="exp.title">Experiencia Profesional</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-brand-violet to-brand-aqua mx-auto rounded-full"></div>
      </div>

      <div class="max-w-4xl mx-auto">
        <!-- Vertical Timeline -->
        <div class="relative border-l border-slate-200 dark:border-slate-700 ml-4 md:ml-6 space-y-12">
          
          {cvData.experience.map((exp, idx) => {
            return (
              <div id={exp.id} class="timeline-item reveal relative pl-8 md:pl-10 scroll-mt-24">
                {idx === 0 ? (
                  <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-brand-aqua z-10 ring-4 ring-brand-aqua/25"></div>
                ) : (
                  <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-brand-violet z-10"></div>
                )}
                
                <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:-translate-y-1 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-all duration-300">
                  <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                    <div>
                      {exp.url ? (
                        <a href={exp.url} target="_blank" rel="noopener noreferrer" class={`inline-flex items-center space-x-1 px-2.5 py-0.5 rounded-full text-xs font-semibold ${badgeClasses[exp.badgeVariant]} hover:opacity-80 transition-opacity`} title={`Sitio web oficial de ${exp.company}`}>
                          <span>{exp.company}</span>
                          <svg class="w-3 h-3 opacity-70" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>
                        </a>
                      ) : (
                        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold ${badgeClasses[exp.badgeVariant]}`}>
                          {exp.company}
                        </span>
                      )}
                      <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5" data-i18n={`exp.${exp.id}.title`}>{exp.role.es}</h3>
                    </div>
                    <div class="text-left sm:text-right w-full sm:w-auto mt-2 sm:mt-0">
                      <span data-i18n={`exp.${exp.id}.date`} class="inline-block text-xs font-bold text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full uppercase tracking-wider text-center sm:text-right">
                        {exp.date.es}
                      </span>
                      <p data-i18n={`exp.${exp.id}.location`} class="text-xs text-slate-500 dark:text-slate-400 mt-2 sm:mt-1">{exp.location.es}</p>
                    </div>
                  </div>
                  
                  <ul class="space-y-2.5 text-sm text-slate-600 dark:text-slate-300 list-disc list-outside ml-4 sm:ml-5 marker:text-brand-violet dark:marker:text-brand-violet-light leading-relaxed">
                    {exp.bullets.map((b, bIdx) => (
                      <li data-i18n={`exp.${exp.id}.b${bIdx + 1}`} set:html={b.es} />
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}

        </div>
      </div>
    </div>
  </section>
  </div>

  <!-- Skills Section -->
  <section id="skills" class="py-20 transition-colors scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-3 mb-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n="skills.title">Habilidades & Herramientas</h2>
        <div class="w-16 h-1 bg-gradient-to-r from-brand-violet to-brand-aqua mx-auto rounded-full"></div>
