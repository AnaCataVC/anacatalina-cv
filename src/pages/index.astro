---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PoppyBackground from '../components/PoppyBackground.astro';
import fotoPerfil from '../assets/foto-perfil.jpg';

// Single source of truth: the badge markup below is omitted from the HTML
// entirely when false, instead of being hidden client-side after JS runs.
const isAvailableForWork = false;
---
<Layout title="Ana-Catalina Villalobos | Ingeniera Civil & Data Scientist" description="CV y Portafolio Profesional de Ana-Catalina Villalobos Contardo, Ingeniera Civil, Data Scientist y ML Engineer especialista en pipelines de datos y modelos predictivos.">
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Ana-Catalina Villalobos Contardo",
      "jobTitle": "Data Scientist & Machine Learning Engineer",
      "url": "https://cv.ana-catalina.com/",
      "sameAs": [
        "https://linkedin.com/in/ana-catalina/",
        "https://github.com/AnaCataVC/"
      ],
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": "Universidad de Chile"
      },
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Región Metropolitana",
        "addressCountry": "CL"
      }
    }
  </script>

  <!-- Hero and Experience Wrapper for Background Glow -->
  <div class="relative overflow-hidden">
  <!-- Hero Section -->
  <header id="home" class="relative w-full pt-12 pb-16 md:pt-0 md:pb-0 md:min-h-screen md:flex md:items-center">
    <!-- Background Blur Blobs for Premium Aesthetic -->
    

    

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
        <!-- Profile details & Photo (Left Column on Desktop, Top on Mobile) -->
        <div class="md:col-span-6 flex flex-col items-center md:items-start text-center md:text-left space-y-6 animate-fade-in-up">
          {isAvailableForWork && (
            <div id="availability-badge" class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-pastel-mint/45 dark:bg-pastel-mint/10 border border-pastel-mint text-emerald-800 dark:text-emerald-300 font-medium text-xs tracking-wide">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
              <span data-i18n="hero.badge">Disponible para Proyectos & Liderazgo de Datos</span>
            </div>
          )}

          <h1 class="text-[3rem] sm:text-[4.5rem] lg:text-[5rem] font-bold tracking-tight text-slate-900 dark:text-white leading-[1.1] m-0">
            <span class="text-indigo-600 dark:text-indigo-400">Ana-Catalina</span> <br> Villalobos Contardo<span class="bg-gradient-to-br from-purple-500 to-blue-500 bg-clip-text text-transparent">.</span>
          </h1>
          
          <p data-i18n="hero.subtitle" class="text-lg sm:text-xl font-medium text-slate-600 dark:text-slate-300">
            Data Scientist & Machine Learning Engineer
          </p>

          <!-- Interactive Profile Card -->
          <div class="relative pt-2">
            <!-- Decorative outline glows -->

            
            <div class="relative w-56 h-56 sm:w-64 sm:h-64 bg-white dark:bg-slate-800 p-2.5 rounded-2xl shadow-xl flex items-center justify-center overflow-hidden">
              <Image src={fotoPerfil} alt="Ana-Catalina Villalobos" width={320} height={320} loading="eager" fetchpriority="high" format="webp" quality={80} class="w-full h-full object-cover rounded-xl" />
            </div>
            
            <!-- Minimal tag overlay linked to SimpliRoute experience -->
            <a href="#simpliroute" class="absolute -bottom-4 left-1/2 -translate-x-1/2 whitespace-nowrap bg-white dark:bg-slate-800 px-4 py-2 rounded-xl shadow-lg border border-slate-100 dark:border-slate-700 flex items-center space-x-2 hover:border-indigo-500 dark:hover:border-indigo-400 transition-colors group/tag">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-indigo-500"></span>
              </span>
              <span class="text-xs font-semibold text-slate-700 dark:text-slate-300 group-hover/tag:text-indigo-600 dark:group-hover/tag:text-indigo-400 transition-colors">Learning Engineer @ SimpliRoute</span>
            </a>
          </div>

          <!-- Action Buttons (Mobile) -->
          <div class="flex md:hidden flex-wrap items-center justify-center gap-3 w-56 sm:w-64 pt-4">
            <a href="ACVC_es.pdf" target="_blank" rel="noopener noreferrer" data-i18n="hero.downloadBtn" data-i18n-href="hero.cvUrl" class="flex-1 min-w-[120px] inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold text-white bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-400 hover:to-blue-400 rounded-xl shadow-sm transition-all transform hover:-translate-y-0.5">
              Descargar CV
            </a>
          </div>

          <!-- Social Details Quick Links & Location -->
          <div class="flex flex-wrap justify-center items-center gap-y-2 gap-x-6 pt-2 text-slate-600 dark:text-slate-400 w-56 sm:w-64">
            <a href="mailto:anacatalina@outlook.cl" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" title="Email" aria-label="Email">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            </a>
            <a href="https://linkedin.com/in/ana-catalina/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" title="LinkedIn" aria-label="LinkedIn">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
            <a href="https://github.com/AnaCataVC/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" title="GitHub" aria-label="GitHub">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
            <span class="text-sm inline-flex md:hidden items-center space-x-1.5 font-medium whitespace-nowrap">
              <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span data-i18n="hero.location">Región Metropolitana, Chile</span>
            </span>
          </div>
        </div>

        <!-- About Me Section (Right Column on Desktop, Bottom on Mobile) -->
        <div class="md:col-span-6 flex flex-col justify-center space-y-6 animate-fade-in md:pl-6 relative">
          <PoppyBackground class="absolute top-1/2 -translate-y-1/2 -right-20 w-[600px] h-[600px] lg:w-[800px] lg:h-[800px] opacity-[0.04] dark:opacity-[0.06] pointer-events-none text-indigo-900 dark:text-indigo-100 -z-10" />
          <!-- "Sobre Mí" Title -->
          <h2 class="text-xl font-bold tracking-wider text-indigo-600 dark:text-indigo-400 uppercase text-center md:text-left mb-4" data-i18n="about.title">Sobre Mí</h2>

          <!-- Desktop Top Meta & Actions -->
          <div class="hidden md:flex flex-col space-y-5 mb-4">
            <span class="text-sm inline-flex items-center space-x-1.5 font-medium whitespace-nowrap text-slate-600 dark:text-slate-400">
              <svg class="w-4 h-4 text-slate-500 dark:text-slate-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>
              </svg>
              <span data-i18n="hero.location">Región Metropolitana, Chile</span>
            </span>

            <div class="flex flex-wrap items-center justify-start gap-3 lg:gap-4">
              <a href="ACVC_es.pdf" target="_blank" rel="noopener noreferrer" data-i18n="hero.downloadBtn" data-i18n-href="hero.cvUrl" class="flex-1 lg:flex-none lg:min-w-[140px] inline-flex items-center justify-center px-4 lg:px-5 py-2.5 lg:py-3 text-xs lg:text-sm font-semibold text-white bg-gradient-to-r from-purple-500 to-blue-500 hover:from-purple-400 hover:to-blue-400 rounded-xl shadow-sm transition-all transform hover:-translate-y-0.5">
                Descargar CV
              </a>
              <a href="#experience" data-i18n="hero.expBtn" class="flex-1 lg:flex-none lg:min-w-[140px] inline-flex items-center justify-center px-4 lg:px-5 py-2.5 lg:py-3 text-xs lg:text-sm font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 rounded-xl transition-all transform hover:-translate-y-0.5">
                Experiencia
              </a>
              <a href="#skills" data-i18n="hero.skillsBtn" class="flex-1 lg:flex-none lg:min-w-[140px] inline-flex items-center justify-center px-4 lg:px-5 py-2.5 lg:py-3 text-xs lg:text-sm font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-slate-300 rounded-xl transition-all transform hover:-translate-y-0.5">
                Habilidades
              </a>
            </div>
          </div>
          
          <div class="space-y-4 text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed text-sm sm:text-base text-justify md:text-left">
            <p data-i18n="about.p1" class="text-lg font-semibold text-slate-800 dark:text-slate-100 leading-relaxed text-justify md:text-left">
              Ingeniera especializada en Ciencia de Datos, Machine Learning e IA Agéntica, con experiencia liderando equipos y construyendo sistemas inteligentes para logística, automatización y análisis avanzado.
            </p>
            <p data-i18n="about.p2">
              De formación Ingeniera Civil de la Universidad de Chile, me motiva aplicar Machine Learning para resolver problemas complejos y transformar datos en valor real, tal como lo plasmé en mi trabajo de tesis publicado en <a href="#education" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Structural Control Health Monitoring</a> en 2021.
            </p>
            <p data-i18n="about.p3">
              A lo largo de mi trayectoria, he liderado equipos multidisciplinarios y colaborado en el desarrollo de soluciones tecnológicas donde la ingeniería, el análisis avanzado y el impacto práctico convergen.
            </p>
            <p data-i18n="about.p4">
              Actualmente como <a href="#simpliroute" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Learning Engineer en SimpliRoute</a>, contribuyo al diseño de soluciones de optimización, al desarrollo de servidores MCP e integración de IA, y al procesamiento de datos a escala.
            </p>
          </div>
        </div>
      </div>
    </div>
  </header>



  <!-- Experience Section -->
  <section id="experience" class="py-20 relative scroll-mt-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center space-y-3 mb-16">
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white" data-i18n="exp.title">Experiencia Profesional</h2>
        <div class="w-16 h-1.5 bg-pastel-pink mx-auto rounded-full"></div>
      </div>

      <div class="max-w-4xl mx-auto">
        <!-- Vertical Timeline -->
        <div class="relative border-l border-slate-200 dark:border-slate-700 ml-4 md:ml-6 space-y-12">
          
          <!-- Timeline Item 1 -->
          <div id="simpliroute" class="timeline-item reveal relative pl-8 md:pl-10 scroll-mt-24">
            <!-- Timeline Line Dot -->
            <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-indigo-600 z-10"></div>
            
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:-translate-y-1 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-all duration-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pastel-lilac/30 dark:bg-pastel-lilac/10 text-indigo-900 dark:text-indigo-300">
                    SimpliRoute
                  </span>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5">Learning Engineer</h3>
                </div>
                <div class="text-left sm:text-right w-full sm:w-auto mt-2 sm:mt-0">
                  <span data-i18n="exp.simpliroute.date" class="inline-block text-xs font-bold text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full uppercase tracking-wider text-center sm:text-right">
                    Agosto 2025 - Presente
                  </span>
                  <p data-i18n="exp.simpliroute.location" class="text-xs text-slate-500 dark:text-slate-400 mt-2 sm:mt-1">Santiago, Chile (Remoto)</p>
                </div>
              </div>
              
              <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc list-inside">
                <li data-i18n="exp.simpliroute.b1">Diseño e implementación de <strong class="text-slate-800 dark:text-slate-100 font-semibold">soluciones para la optimización de rutas y geolocalización</strong>, con foco en mejorar la precisión de georreferencias y aumentar la exactitud de ruteo.</li>
                <li data-i18n="exp.simpliroute.b2">Diseño y desarrollo de <strong class="text-slate-800 dark:text-slate-100 font-semibold">servidores Model Context Protocol (MCP)</strong> para el motor de optimización, permitiendo a modelos de lenguaje (LLMs) y agentes interactuar de forma segura y estructurada con el solucionador logístico.</li>
                <li data-i18n="exp.simpliroute.b3">Gestión y modelado de datos a gran escala en <strong class="text-slate-800 dark:text-slate-100 font-semibold">Google BigQuery</strong> y orquestación de flujos de eventos y datos utilizando <strong class="text-slate-800 dark:text-slate-100 font-semibold">Google Pub/Sub y Apache Airflow</strong>, asegurando alta calidad, trazabilidad y confiabilidad operativa.</li>
                <li data-i18n="exp.simpliroute.b4">Integración de <strong class="text-slate-800 dark:text-slate-100 font-semibold">LLMs y GenAI en procesos internos y productos</strong>, incorporando herramientas asistidas por IA como <strong class="text-slate-800 dark:text-slate-100 font-semibold">Claude Code</strong> para acelerar ciclos de iteración, optimizar pruebas y elevar la eficiencia operativa.</li>
              </ul>
            </div>
          </div>

          <!-- Timeline Item 2 -->
          <div class="timeline-item reveal relative pl-8 md:pl-10">
            <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-indigo-600 z-10"></div>
            
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:-translate-y-1 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-all duration-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pastel-pink/30 dark:bg-pastel-pink/10 text-pink-900 dark:text-pink-300">
                    Fracttal
                  </span>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5" data-i18n="exp.fracttal1.title">Tech Lead Fracttal Hub</h3>
                </div>
                <div class="text-left sm:text-right w-full sm:w-auto mt-2 sm:mt-0">
                  <span data-i18n="exp.fracttal1.date" class="inline-block text-xs font-bold text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full uppercase tracking-wider text-center sm:text-right">
                    Noviembre 2023 - Julio 2025
                  </span>
                  <p data-i18n="exp.fracttal1.location" class="text-xs text-slate-500 dark:text-slate-400 mt-2 sm:mt-1">Santiago, Chile</p>
                </div>
              </div>
              
              <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc list-inside">
                <li data-i18n="exp.fracttal1.b1"><strong class="text-slate-800 dark:text-slate-100 font-semibold">Liderazgo de equipo multidisciplinario de integraciones</strong> con personas en distintos países, enfocado en mentoría técnica, desarrollo profesional y un entorno colaborativo.</li>
                <li data-i18n="exp.fracttal1.b2">Planificación estratégica del roadmap de Fracttal Hub, alineando los objetivos de negocio y la entrega continua de valor a clientes.</li>
                <li data-i18n="exp.fracttal1.b3">Desarrollo en Python para librerías de procesamiento de datos y orquestación de tareas, habilitando la integración con múltiples fuentes y destinos, con <strong class="text-slate-800 dark:text-slate-100 font-semibold">más de 100 acciones posibles</strong> y capacidades avanzadas de transformación.</li>
                <li data-i18n="exp.fracttal1.b4">Supervisión y coordinación de proyectos de integración para decenas de clientes, aplicando gestión eficiente de recursos, plazos y flujos de datos confiables.</li>
              </ul>
            </div>
          </div>

          <!-- Timeline Item 3 -->
          <div class="timeline-item reveal relative pl-8 md:pl-10">
            <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-indigo-600 z-10"></div>
            
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:-translate-y-1 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-all duration-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pastel-blue/30 dark:bg-pastel-blue/10 text-blue-900 dark:text-blue-300">
                    Fracttal
                  </span>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5">Data Scientist</h3>
                </div>
                <div class="text-left sm:text-right w-full sm:w-auto mt-2 sm:mt-0">
                  <span data-i18n="exp.fracttal2.date" class="inline-block text-xs font-bold text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full uppercase tracking-wider text-center sm:text-right">
                    Agosto 2021 - Noviembre 2023
                  </span>
                  <p data-i18n="exp.fracttal1.location" class="text-xs text-slate-500 dark:text-slate-400 mt-2 sm:mt-1">Santiago, Chile</p>
                </div>
              </div>
              
              <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc list-inside">
                <li data-i18n="exp.fracttal2.b1">Diseño e implementación de procesos de ciencia de datos para las plataformas Predictto y Fracttal One, con foco en generar valor a partir de datos operacionales de maquinaria.</li>
                <li data-i18n="exp.fracttal2.b2">Desarrollo de modelos analíticos aplicados a <strong class="text-slate-800 dark:text-slate-100 font-semibold">mantenimiento predictivo, priorización de activos y predicción de fallas</strong> combinando ML, estadística y conocimiento del dominio.</li>
                <li data-i18n="exp.fracttal2.b3">Colaboración en la creación y desarrollo de producto para gestionar integraciones entre Fracttal y otras plataformas de software empresariales.</li>
                <li data-i18n="exp.fracttal2.b4">Evaluación continua de modelos en producción, optimizando pipelines de datos para garantizar la precisión y robustez en entornos reales.</li>
              </ul>
            </div>
          </div>

          <!-- Timeline Item 4 -->
          <div class="timeline-item reveal relative pl-8 md:pl-10">
            <div class="timeline-dot absolute -left-2 top-1.5 w-4 h-4 rounded-full border-2 border-white dark:border-slate-900 bg-indigo-600 z-10"></div>
            
            <div class="bg-white dark:bg-slate-800 p-6 rounded-2xl border border-slate-200 dark:border-slate-700 hover:-translate-y-1 hover:border-slate-300 dark:hover:border-slate-600 hover:shadow-xl hover:shadow-slate-200/50 dark:hover:shadow-black/30 transition-all duration-300">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-pastel-mint/45 dark:bg-pastel-mint/10 text-emerald-900 dark:text-emerald-300">
                    Fracttal
                  </span>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white mt-1.5" data-i18n="exp.fracttal3.title">Analista de Datos</h3>
                </div>
                <div class="text-left sm:text-right w-full sm:w-auto mt-2 sm:mt-0">
                  <span data-i18n="exp.fracttal3.date" class="inline-block text-xs font-bold text-slate-600 dark:text-slate-400 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full uppercase tracking-wider text-center sm:text-right">
                    Febrero 2020 - Julio 2021
                  </span>
                  <p data-i18n="exp.fracttal1.location" class="text-xs text-slate-500 dark:text-slate-400 mt-2 sm:mt-1">Santiago, Chile</p>
                </div>
              </div>
              
              <ul class="space-y-2 text-sm text-slate-600 dark:text-slate-300 list-disc list-inside">
                <li data-i18n="exp.fracttal3.b1">Desarrollo desde cero de la herramienta de mantenimiento predictivo, utilizando análisis estadístico avanzado y modelos preliminares de Machine Learning.</li>
                <li data-i18n="exp.fracttal3.b2">Diseño, manejo y optimización de bases de datos relacionales para almacenar lecturas de telemetría e historial de mantenimiento.</li>
                <li data-i18n="exp.fracttal3.b3">Apoyo en el desarrollo web frontend/backend básico de visualizaciones de datos y métricas para tomadores de decisiones.</li>
